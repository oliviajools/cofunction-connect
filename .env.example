# ─── Supabase (Projekt → Settings → API) ───────────────────────────────
# Ohne diese beiden Werte läuft die App im Demo-Modus mit Beispieldaten.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Geheimer Schlüssel – NUR serverseitig (Mail-Eingang, Hintergrundverarbeitung). Nie im Browser, nie ins Repo.
SUPABASE_SECRET_KEY=sb_secret_...

# ─── Transkription (console.mistral.ai → API Keys) ─────────────────────
# Ohne Schlüssel werden Aufnahmen gespeichert, aber nicht transkribiert.
MISTRAL_API_KEY=
# MISTRAL_TRANSKRIPTION_MODELL=voxtral-mini-latest

# ─── Mail-Eingang ──────────────────────────────────────────────────────
NEXT_PUBLIC_MAIL_ADRESSE=wissen@cofunction.de
# Langes Zufallsgeheimnis, z. B. `openssl rand -hex 32`
MAIL_WEBHOOK_SECRET=

# ─── Sicherheitsnetz für hängende Verarbeitung (Vercel Cron) ───────────
CRON_SECRET=
